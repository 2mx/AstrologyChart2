{
  "name": "astrochart2",
  "version": "0.7.3",
  "description": "A JavaScript for generating Astrology charts.",
  "keywords": [
    "astrology",
    "chart",
    "horoscope",
    "zodiac",
    "ephemeris"
  ],
  "author": {
    "name": "Tom Jurman",
    "email": "tomasjurman@kibo.cz"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Kibo/AstrologyChart2.git"
  },
  "license": "GPLV3",
  "type": "module",
  "main": "./dist/astrochart2.js",
  "module": "./dist/astrochart2.js",
  "exports": {
    ".": {
      "import": "./dist/astrochart2.js"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/plugin-transform-modules-commonjs": "^7.21.2",
    "@babel/preset-env": "^7.21.4",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jsdoc": "^4.0.2",
    "terser": "^5.46.2",
    "vite": "^7.3.1",
    "vite-plugin-banner": "^0.8.1"
  },
  "scripts": {
    "dev": "vite",
    "watch": "vite build --watch --mode debug",
    "build": "vite build --mode debug && vite build --mode production",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "doc": "jsdoc -c jsdoc.json"
  }
}
